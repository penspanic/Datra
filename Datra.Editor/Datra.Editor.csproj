<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Datra.Editor</RootNamespace>
    <AssemblyName>Datra.Editor</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Datra.Editor</PackageId>
    <Description>Editor schema and editable data-source primitives for Datra-managed game data.</Description>
    <PackageTags>datra;game;data;editor;schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Datra/Datra.csproj" />
  </ItemGroup>

</Project>
