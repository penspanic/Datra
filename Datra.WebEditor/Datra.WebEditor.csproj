<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Multi-target so consumers pick the right matching ASP.NET Core surface for their
             host TFM (e.g. OFF + tidemark on net10, samples/tests on net9). -->
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Datra.WebEditor</RootNamespace>
        <AssemblyName>Datra.WebEditor</AssemblyName>
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
        <!-- Blazor RenderTreeBuilder loops legitimately use seq++ for dynamic content -->
        <NoWarn>$(NoWarn);ASP0006</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Datra.WebEditor</PackageId>
        <Description>Blazor RCL providing a schema-driven web editor for Datra-managed game data. Auto-enumerates ITableRepository&lt;,&gt; properties on a DataContext; no per-game boilerplate.</Description>
        <PackageTags>datra;game;data;editor;blazor;razor;rcl</PackageTags>
    </PropertyGroup>

    <!-- Use Components.Web (NuGet) instead of FrameworkReference: keeps the RCL consumable
         from Blazor WASM where the AspNetCore.App framework pack isn't available.
         Version pinned per TFM so each consumer's host gets a non-downgrading reference. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Datra\Datra.csproj" />
        <ProjectReference Include="..\Datra.Editor\Datra.Editor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

</Project>
