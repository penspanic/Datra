@*
    Table view for a single Datra type. Driven entirely by reflection over the data type and the
    bound EditableDataSource — no per-game configuration.
*@
@using System.Reflection
@using Datra.Editor.Interfaces
@using Datra.WebEditor.Services
@implements IDisposable

@inject DatraEditorHostService Host

@if (_dataSource is null)
{
    <div class="datra-table__empty">
        <p>Select a type from the sidebar.</p>
    </div>
}
else
{
    <div class="datra-table">
        <header class="datra-table__header">
            <div class="datra-table__heading">
                <h2 class="datra-table__title">@DataType?.Name</h2>
                @if (_dataSource.HasModifications)
                {
                    <span class="datra-table__badge" title="@_dataSource.GetChangeSummary().TotalCount changes">
                        @_dataSource.GetChangeSummary().TotalCount unsaved
                    </span>
                }
                <span class="datra-table__count">@_dataSource.Count rows</span>
            </div>
            <div class="datra-table__actions">
                <button class="datra-btn datra-btn--ghost" type="button"
                        disabled="@(!_dataSource.HasModifications)"
                        @onclick="OnRevertClicked">Revert</button>
                <button class="datra-btn datra-btn--primary" type="button"
                        disabled="@(!_dataSource.HasModifications)"
                        @onclick="OnSaveClicked">Save</button>
            </div>
        </header>

        @if (_keyType is null)
        {
            <div class="datra-table__empty">
                <p>Only key-value (table) repositories are editable in this view.</p>
            </div>
        }
        else
        {
            <div class="datra-table__scroll">
                <table class="datra-table__grid">
                    <thead>
                        <tr>
                            <th class="datra-table__col-key">@_keyType.Name <span class="datra-table__col-meta">key</span></th>
                            @foreach (var column in _columns)
                            {
                                <th>@column.Name</th>
                            }
                            <th class="datra-table__col-actions" aria-label="row actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in EnumerateItems())
                    {
                        var key = _dataSource.GetItemKey(item)!;
                        var state = _dataSource.GetItemState(key);
                        <tr class="@RowClass(state)" @key="key">
                            <td class="datra-table__cell-key">
                                <span class="datra-table__key">@key</span>
                                @if (state == ItemState.Added) { <span class="datra-table__state datra-table__state--added">new</span> }
                                else if (state == ItemState.Deleted) { <span class="datra-table__state datra-table__state--deleted">deleted</span> }
                                else if (state == ItemState.Modified) { <span class="datra-table__state datra-table__state--modified">edited</span> }
                            </td>
                            @foreach (var column in _columns)
                            {
                                var dirty = _dataSource.IsPropertyModified(key, column.Name);
                                <td class="@(dirty ? "datra-table__cell datra-table__cell--dirty" : "datra-table__cell")">
                                    <DatraField FieldType="@column.PropertyType"
                                                Property="@column"
                                                Target="@item"
                                                Value="@column.GetValue(item)"
                                                LayoutMode="@FieldLayoutMode.Table"
                                                OnValueChanged="@(value => HandleFieldChange(item, key, column, value))" />
                                </td>
                            }
                            <td class="datra-table__cell-actions">
                                <button class="datra-btn datra-btn--ghost datra-btn--sm" type="button"
                                        title="delete"
                                        @onclick="() => OnRowDelete(key)">×</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                @if (_dataSource.Count == 0)
                {
                    <div class="datra-table__empty datra-table__empty--inline">
                        <p>No rows yet. Add the first one below.</p>
                    </div>
                }
            </div>

            <footer class="datra-table__footer">
                <div class="datra-table__add">
                    <input class="datra-input datra-input--number datra-table__add-key" type="text"
                           placeholder="@(_keyType.Name) id"
                           @bind="_pendingKey" @bind:event="oninput"
                           @onkeyup="OnAddKeyUp" />
                    <button class="datra-btn datra-btn--primary datra-btn--sm" type="button"
                            disabled="@(string.IsNullOrWhiteSpace(_pendingKey))"
                            @onclick="OnAddClicked">+ Add row</button>
                    @if (!string.IsNullOrEmpty(_addError))
                    {
                        <span class="datra-table__add-error">@_addError</span>
                    }
                </div>
            </footer>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Type? DataType { get; set; }

    private IEditableDataSource? _dataSource;
    private Type? _keyType;
    private Type? _valueType;
    private List<PropertyInfo> _columns = new();
    private string _pendingKey = string.Empty;
    private string? _addError;

    protected override void OnInitialized() => Host.StateChanged += OnHostStateChanged;
    public void Dispose() => Host.StateChanged -= OnHostStateChanged;

    protected override void OnParametersSet()
    {
        _addError = null;
        _pendingKey = string.Empty;

        if (DataType is null)
        {
            _dataSource = null;
            _keyType = null;
            _valueType = null;
            _columns = new();
            return;
        }

        _dataSource = Host.GetDataSource(DataType);
        if (_dataSource is null)
        {
            _keyType = null;
            _valueType = null;
            _columns = new();
            return;
        }

        var kv = _dataSource.GetKeyValueTypes();
        _keyType = kv?.Key;
        _valueType = kv?.Data;

        _columns = DataType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.GetIndexParameters().Length == 0)
            // Hide the "Id" key column — it's already shown in the dedicated key cell.
            .Where(p => !string.Equals(p.Name, "Id", StringComparison.Ordinal))
            .ToList();
    }

    private IEnumerable<object> EnumerateItems()
    {
        if (_dataSource is null) yield break;
        foreach (var item in _dataSource.EnumerateItems()) yield return item;
    }

    private static string RowClass(ItemState state) => state switch
    {
        ItemState.Added => "datra-table__row datra-table__row--added",
        ItemState.Modified => "datra-table__row datra-table__row--modified",
        ItemState.Deleted => "datra-table__row datra-table__row--deleted",
        _ => "datra-table__row",
    };

    private void HandleFieldChange(object item, object key, PropertyInfo column, object? newValue)
    {
        if (_dataSource is null) return;
        column.SetValue(item, newValue);
        _dataSource.TrackPropertyChange(key, column.Name, newValue, out _);
        StateHasChanged();
    }

    private async Task OnSaveClicked()
    {
        if (DataType is null) return;
        await Host.SaveAsync(DataType);
    }

    private void OnRevertClicked()
    {
        _dataSource?.Revert();
        StateHasChanged();
    }

    private void OnRowDelete(object key)
    {
        if (_dataSource is null) return;
        var state = _dataSource.GetItemState(key);
        if (state == ItemState.Added)
        {
            _dataSource.DeleteItem(key);
        }
        else
        {
            _dataSource.DeleteItem(key);
        }
        StateHasChanged();
    }

    private void OnAddKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") OnAddClicked();
    }

    private void OnAddClicked()
    {
        _addError = null;
        if (_dataSource is null || _keyType is null || _valueType is null) return;

        var (ok, key) = DatraEditorHostServiceExtensions.TryParseKey(_keyType, _pendingKey);
        if (!ok || key is null)
        {
            _addError = $"Invalid {_keyType.Name} key";
            return;
        }
        if (_dataSource.ContainsKey(key))
        {
            _addError = "Key already exists";
            return;
        }

        var value = DatraEditorHostServiceExtensions.CreateDefaultValue(_valueType);
        if (value is null)
        {
            _addError = $"{_valueType.Name} lacks a parameterless constructor";
            return;
        }
        DatraEditorHostServiceExtensions.StampKey(value, key);
        _dataSource.AddItem(key, value);

        _pendingKey = string.Empty;
        StateHasChanged();
    }

    private void OnHostStateChanged() => InvokeAsync(StateHasChanged);
}
