@*
    Top-level Datra editor shell. Mount with `<DatraEditor />` after registering the services
    via `services.AddDatraWebEditor(...)`. The shell handles its own initialisation and routing
    between data types via in-component state — no router required.
*@
@using Datra.Interfaces
@using Datra.WebEditor.Services
@implements IDisposable

@inject DatraEditorBootstrapper Bootstrapper
@inject DatraEditorHostService Host

<div class="datra-editor @(string.IsNullOrEmpty(Theme) ? "" : "")"
     data-datra-theme="@Theme">
    @if (!_ready)
    {
        <div class="datra-editor__loading">
            <span class="datra-editor__spinner" aria-hidden="true"></span>
            <span>Loading data context…</span>
        </div>
    }
    else
    {
        @if (!HideSidebar && !Compact)
        {
            <aside class="datra-editor__nav">
                <DatraTypeSidebar Selected="_selected" OnSelect="OnSelectType" />
            </aside>
        }

        <main class="datra-editor__content">
            @{
                var info = _selected is null ? null : Host.GetDataTypeInfo(_selected);
            }
            @if (ShouldShowDetail)
            {
                <DatraRecordView DataType="_selected"
                                 ItemKey="@ActiveDetailKey"
                                 Compact="@Compact"
                                 ShowBackButton="@(_showDetail && !Compact)"
                                 OnBack="BackToTable" />
            }
            else
            {
                @switch (info?.RepositoryKind)
                {
                    case Datra.Interfaces.RepositoryKind.Single:
                        <DatraSingleView DataType="_selected" />
                        break;
                    case Datra.Interfaces.RepositoryKind.Asset:
                        <DatraAssetView DataType="_selected" OnOpenDetail="OpenDetail" />
                        break;
                    case Datra.Interfaces.RepositoryKind.Table:
                    default:
                        <DatraTableView DataType="_selected" OnOpenDetail="OpenDetail" />
                        break;
                }
            }
        </main>
    }
</div>

@code {
    /// <summary>Optional theme name — currently "light" switches to the light palette.</summary>
    [Parameter] public string? Theme { get; set; }

    /// <summary>Optional data type to focus. Accepts full name or simple type name.</summary>
    [Parameter] public string? FocusType { get; set; }

    /// <summary>Optional row key to focus. When present, the editor opens in detail mode.</summary>
    [Parameter] public string? FocusKey { get; set; }

    /// <summary>"auto" (default), "table", or "detail".</summary>
    [Parameter] public string ViewMode { get; set; } = "auto";

    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool HideSidebar { get; set; }

    /// <summary>Callback fired after every successful save or reload.</summary>
    [Parameter] public EventCallback<DataChangedEvent> OnDataChanged { get; set; }

    [Inject] private IDataChangedNotifier Notifier { get; set; } = default!;

    private bool _ready;
    private Type? _selected;
    private bool _showDetail;
    private string? _detailKey;

    private bool ShouldShowDetail =>
        string.Equals(ViewMode, "detail", StringComparison.OrdinalIgnoreCase)
        || _showDetail
        || (!string.Equals(ViewMode, "table", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(FocusKey));

    private string? ActiveDetailKey => _detailKey ?? FocusKey;

    protected override async Task OnInitializedAsync()
    {
        await Bootstrapper.EnsureInitialisedAsync();
        _selected = ResolveFocusType() ?? Host.DataTypes.FirstOrDefault()?.DataType;
        _ready = true;
        Host.StateChanged += OnHostStateChanged;
        Notifier.Changed += OnNotifierChanged;
    }

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        var focusType = ResolveFocusType();
        if (focusType is not null && focusType != _selected)
        {
            _selected = focusType;
            _showDetail = false;
            _detailKey = null;
        }
    }

    private Type? ResolveFocusType() => Host.FindDataType(FocusType);

    private void OnSelectType(Type type)
    {
        _selected = type;
        _showDetail = false;
        _detailKey = null;
    }

    private Task OpenDetail(string key)
    {
        _detailKey = key;
        _showDetail = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task BackToTable()
    {
        _showDetail = false;
        _detailKey = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnNotifierChanged(DataChangedEvent evt)
    {
        if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync(evt);
        await InvokeAsync(StateHasChanged);
    }

    private void OnHostStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Host.StateChanged -= OnHostStateChanged;
        Notifier.Changed -= OnNotifierChanged;
    }
}
